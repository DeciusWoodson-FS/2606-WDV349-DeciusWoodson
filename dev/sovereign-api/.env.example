MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sovereign
PORT=4000

# Better-Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=<at-least-32-random-characters>
# The API's own address
BETTER_AUTH_URL=http://localhost:4000
# The frontend's address, allowed by CORS and trusted for sign-in
CLIENT_ORIGIN=http://localhost:5173
